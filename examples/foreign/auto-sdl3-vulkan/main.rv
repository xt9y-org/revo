# Import native SDL3 and vulkan-zig directly: no handwritten Zig shim.
const sdl = import "./sdl_revo.so"
const vk = import "./vulkan_revo.so"

print(vk.makeApiVersion(0, 1, 0, 0))

if not sdl.SDL_Init(32) do
    print("SDL video initialization failed:")
    panic(sdl.SDL_GetError())
end

# SDL3 recommends loading Vulkan after SDL_Init, before a Vulkan window.
# This exposes missing loader/driver errors before SDL_CreateWindow.
if not sdl.SDL_Vulkan_LoadLibrary(:nil) do
    print("Vulkan loader initialization failed:")
    panic(sdl.SDL_GetError())
end

const window = sdl.SDL_CreateWindow("Revo / SDL3 / Vulkan", 960, 540, 268435456)
if not window do
    print("SDL3 Vulkan window creation failed:")
    panic(sdl.SDL_GetError())
end

print("SDL3 Vulkan window created")
while not sdl.SDL_HasEvent(256) do
    sdl.SDL_PumpEvents()
    sdl.SDL_Delay(16)
end

sdl.SDL_DestroyWindow(window)
sdl.SDL_Vulkan_UnloadLibrary()
sdl.SDL_Quit()
